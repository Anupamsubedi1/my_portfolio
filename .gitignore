# Dependencies
node_modules/
# NOTE: package-lock.json is intentionally COMMITTED. Cloudflare Workers
# Builds installs from it, so leaving it untracked means every CI build
# re-resolves dependencies and a floating minor version can break a deploy
# that worked yesterday.
yarn.lock

